# Copy to .env and adjust if needed. `./run.sh` boots this automatically.
# Read by both the AI service (ai-service) and the launcher (run.sh).
# The mod picks these up as system properties forwarded by Gradle.

# Shared secret between the mod and the AI service.
MINECIV_API_TOKEN=dev-local-token

# URL the Minecraft mod uses to reach the AI service.
MINECIV_AI_BASE_URL=http://127.0.0.1:8765

# AI service bind address/port.
MCIV_HOST=127.0.0.1
MCIV_PORT=8765

# AI service settings: mock (deterministic, offline) or ollama (local LLM).
MINECIV_LLM_PROVIDER=mock
MCIV_DATABASE_URL=sqlite:///data/minecivilization.db
